{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voicebench.invalid/v1/predictions.schema.json",
  "title": "Predictions view built from final events",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/stable_id"
    },
    "mock": {
      "type": "boolean"
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/stable_id"
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "revision"
          ]
        },
        "diarization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/stable_id"
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "revision"
          ]
        }
      },
      "required": [
        "asr",
        "diarization"
      ]
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_rate_hz": {
          "$ref": "common.schema.json#/$defs/sample_rate_hz"
        },
        "duration_samples": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        "source_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "converted_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "converted_sha256",
        "duration_samples",
        "sample_rate_hz",
        "source_sha256"
      ]
    },
    "transcript_granularity": {
      "enum": [
        "recording",
        "utterances",
        "words"
      ]
    },
    "transcript_assembly_policy": {
      "const": "media_order_space_join_v1"
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "utterance_id": {
            "$ref": "common.schema.json#/$defs/stable_id"
          },
          "start_sample": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/nonneg_int64"
              },
              {
                "type": "null"
              }
            ]
          },
          "end_sample": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/nonneg_int64"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string"
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "end_sample",
          "event_ids",
          "start_sample",
          "text",
          "utterance_id"
        ]
      }
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segment_id": {
            "$ref": "common.schema.json#/$defs/stable_id"
          },
          "speaker_id": {
            "$ref": "common.schema.json#/$defs/stable_id"
          },
          "start_sample": {
            "$ref": "common.schema.json#/$defs/nonneg_int64"
          },
          "end_sample": {
            "$ref": "common.schema.json#/$defs/nonneg_int64"
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "end_sample",
          "event_ids",
          "segment_id",
          "speaker_id",
          "start_sample"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consumed_samples": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        "dropped_samples": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        "dropped_ranges": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sample_interval"
          }
        }
      },
      "required": [
        "consumed_samples",
        "dropped_ranges",
        "dropped_samples"
      ]
    },
    "source_events": {
      "$ref": "common.schema.json#/$defs/prefix_descriptor"
    }
  },
  "required": [
    "adapters",
    "audio",
    "coverage",
    "mock",
    "run_id",
    "schema_version",
    "source_events",
    "source_id",
    "speakers",
    "transcript",
    "transcript_assembly_policy",
    "transcript_granularity"
  ]
}
