{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voicebench.invalid/v1/common.schema.json",
  "title": "Shared definitions",
  "description": "Shared $defs; not a document type.",
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "int64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "nonneg_int64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "pos_int64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "sample_rate_hz": {
      "type": "integer",
      "minimum": 1,
      "maximum": 768000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./:-]{1,200}$"
    },
    "language_tag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "wall_time": {
      "type": "string",
      "minLength": 20,
      "description": "ISO-8601 wall-clock timestamp with UTC offset; audit metadata only."
    },
    "sample_interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_sample": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        "end_sample": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        }
      },
      "required": [
        "end_sample",
        "start_sample"
      ],
      "description": "Half-open [start, end) sample range; start < end is a semantic check."
    },
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "den": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "den",
        "num"
      ],
      "description": "Reduced positive fraction within [1, 100]; range/reduction are semantic checks."
    },
    "artifact_digest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "byte_count": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "byte_count",
        "path",
        "sha256"
      ]
    },
    "prefix_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "byte_count": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        "line_count": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "byte_count",
        "line_count",
        "path",
        "sha256"
      ],
      "description": "Identity of the immutable runtime prefix of events.jsonl."
    },
    "metric_status": {
      "enum": [
        "ok",
        "not_computable",
        "unsupported",
        "unavailable",
        "error"
      ]
    },
    "clock_domain": {
      "enum": [
        "none",
        "media",
        "monotonic",
        "virtual"
      ]
    },
    "metric_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "unit",
        "definition_id",
        "sample_count",
        "clock_domain",
        "reason",
        "components"
      ],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/metric_status"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "definition_id": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        "clock_domain": {
          "$ref": "common.schema.json#/$defs/clock_domain"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          },
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unit",
        "definition_id",
        "clock_domain",
        "n",
        "p50",
        "p95",
        "min",
        "max",
        "percentile_method",
        "exclusions",
        "source",
        "reason"
      ],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/metric_status"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "definition_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_domain": {
          "$ref": "common.schema.json#/$defs/clock_domain"
        },
        "n": {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        "p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "p95": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "percentile_method": {
          "const": "nearest_rank_v1"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "$ref": "common.schema.json#/$defs/nonneg_int64"
              }
            },
            "required": [
              "count",
              "reason"
            ]
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "artifact",
            "field"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "n": {
            "minimum": 1
          },
          "p50": {
            "type": "number"
          },
          "p95": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "p50": {
            "type": "null"
          },
          "p95": {
            "type": "null"
          },
          "min": {
            "type": "null"
          },
          "max": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "unit",
        "source",
        "scope",
        "reason"
      ],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/metric_status"
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "runner_process",
            "machine",
            "analysis_process"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "invalid_input",
            "dataset",
            "audio",
            "runtime",
            "recorder",
            "analysis",
            "incompatible",
            "validation",
            "cancelled"
          ]
        },
        "stage": {
          "enum": [
            "created",
            "validated",
            "prepared",
            "running",
            "flushing",
            "scoring",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "category",
        "message",
        "stage"
      ]
    }
  }
}
