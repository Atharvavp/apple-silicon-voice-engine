{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voicebench.invalid/v1/environment.schema.json",
  "title": "Startup environment snapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "created_wall_time": {
      "$ref": "common.schema.json#/$defs/wall_time"
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_version": {
          "type": "string",
          "minLength": 1
        },
        "build_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "build_version",
        "product_version"
      ]
    },
    "arch": {
      "type": "string",
      "minLength": 1
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "$ref": "common.schema.json#/$defs/metric_status"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "reason",
            "source",
            "status",
            "value"
          ]
        },
        "chip": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "$ref": "common.schema.json#/$defs/metric_status"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "reason",
            "source",
            "status",
            "value"
          ]
        },
        "memory_bytes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "$ref": "common.schema.json#/$defs/metric_status"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "reason",
            "source",
            "status",
            "value"
          ]
        },
        "logical_cpu_count": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "$ref": "common.schema.json#/$defs/metric_status"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "reason",
            "source",
            "status",
            "value"
          ]
        }
      },
      "required": [
        "chip",
        "logical_cpu_count",
        "memory_bytes",
        "model"
      ]
    },
    "target_hardware_expectation": {
      "type": "string",
      "minLength": 1
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "swift_version": {
          "type": "string",
          "minLength": 1
        },
        "sdk_version": {
          "type": "string",
          "minLength": 1
        },
        "deployment_target": {
          "type": "string",
          "minLength": 1
        },
        "build_configuration": {
          "enum": [
            "debug",
            "release"
          ]
        }
      },
      "required": [
        "build_configuration",
        "deployment_target",
        "sdk_version",
        "swift_version"
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voicebench_version": {
          "type": "string",
          "minLength": 1
        },
        "git_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "git_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "package_resolved_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "git_dirty",
        "git_revision",
        "package_resolved_sha256",
        "voicebench_version"
      ]
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "lock_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "distributions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "distributions",
        "executable",
        "lock_sha256",
        "version"
      ]
    },
    "analysis_version": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "unicode_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "ContinuousClock"
        },
        "minimum_resolution_ns": {
          "$ref": "common.schema.json#/$defs/int64"
        }
      },
      "required": [
        "minimum_resolution_ns",
        "source"
      ]
    },
    "telemetry_capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "common.schema.json#/$defs/metric_status"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "reason",
          "source",
          "status",
          "value"
        ]
      }
    },
    "run_conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warm_state": {
          "type": "string"
        },
        "background_load": {
          "type": "string"
        }
      },
      "required": [
        "background_load",
        "warm_state"
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "$ref": "common.schema.json#/$defs/metric_status"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "reason",
              "source",
              "status",
              "value"
            ]
          }
        }
      },
      "required": [
        "observed",
        "requested"
      ]
    }
  },
  "required": [
    "analysis_version",
    "arch",
    "build",
    "clock",
    "created_wall_time",
    "hardware",
    "locale",
    "os",
    "placement",
    "python",
    "run_conditions",
    "run_id",
    "schema_version",
    "target_hardware_expectation",
    "telemetry_capabilities",
    "toolchain",
    "unicode_version"
  ]
}
