{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voicebench.invalid/v1/status.schema.json",
  "title": "Run lifecycle status (status.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "state": {
      "enum": [
        "created",
        "validated",
        "prepared",
        "running",
        "flushing",
        "scoring",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "updated_wall_time": {
      "$ref": "common.schema.json#/$defs/wall_time"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_event_sequence": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/nonneg_int64"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/artifact_digest"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "artifacts",
    "failure",
    "last_event_sequence",
    "run_id",
    "schema_version",
    "state",
    "updated_wall_time"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "failed",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "failure": {
            "$ref": "common.schema.json#/$defs/failure"
          }
        }
      },
      "else": {
        "properties": {
          "failure": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "created",
              "validated",
              "prepared",
              "running",
              "flushing",
              "scoring"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "type": "null"
          }
        }
      }
    }
  ]
}
